# Copy file to .env. Do NOT commit .env.
PORT=3000
SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.vn
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Leave empty to show "Chua ket noi" and disable AI generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Optional: trusted compatible image-service endpoint; default OpenAI. Keep HTTPS in production.
# OPENAI_IMAGES_ENDPOINT=https://api.openai.com/v1
AI_MAX_PER_HOUR=10
AI_MAX_PER_DAY=30
# 1 = test orders, not real business; 0 = allow live orders after review and compliance.
DEMO_MODE=1
# Persistent storage required for SQLite and uploads; configure mounted disk in production.
DATA_DIR=./storage

# Khi bat 1 va da cau hinh OPENAI_API_KEY, backend TU TAO anh nen khi chay;
# khong can viet prompt hay bam tao tung san pham. Co chi phi API.
# Anh tao se cho kiem duyet trong /quan-tri/thu-vien, khong tu dang.
AI_AUTO_ON_START=0
AI_AUTO_TARGETS=all
AI_AUTO_DAILY_LIMIT=5
AI_AUTO_BATCH_SIZE=3
